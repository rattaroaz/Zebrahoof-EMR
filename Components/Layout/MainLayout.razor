@inherits LayoutComponentBase
@implements IDisposable
@inject AuthStateService AuthState
@inject AppStateService AppState
@inject NotificationService Notifications
@inject NavigationManager Navigation
@inject MockClinicalDataService ClinicalData
@inject DashboardAskSession DashboardAskSession
@inject AskAiCoordinator AskAi
@inject NavigationTrail Trail
@inject AuthenticationStateProvider AuthenticationState
@inject AuthSyncService AuthSync
@inject IJSRuntime JS

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
        <MudAppBar Elevation="1" Dense="true" Color="Color.Surface">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" aria-label="Open navigation" OnClick="@ToggleDrawer" />
            <MudImage Src="images/logo.svg" Alt="Zebrahoof EMR" Height="32" Class="mr-2" />
            <MudText Typo="Typo.h6" Class="mr-4 app-wordmark">Zebrahoof EMR</MudText>
            
            <GlobalSearch />

            <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.AutoAwesome"
                       Class="ml-2 ask-ai-appbar" aria-label="Ask AI" OnClick="AskAi.RequestOpen">
                Ask AI
            </MudButton>
            
            <MudSpacer />
            
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Icon="@Icons.Material.Filled.LocationOn" Class="cursor-pointer">
                        @AuthState.CurrentLocation
                    </MudChip>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var location in AuthStateService.AvailableLocations)
                    {
                        var isCurrentLocation = location == AuthState.CurrentLocation;
                        <MudMenuItem 
                            Icon="@Icons.Material.Filled.LocationOn" 
                            OnClick="() => SetLocation(location)"
                            Disabled="@isCurrentLocation">
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.body2">@location</MudText>
                                @if (isCurrentLocation)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" />
                                }
                            </MudStack>
                        </MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
            
            <MudBadge Content="@_unreadMessages" Color="Color.Error" Overlap="true" Visible="@(_unreadMessages > 0)" Class="mx-2">
                <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" Href="/inbox" aria-label="Inbox notifications" />
            </MudBadge>
            
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" 
                           Color="Color.Inherit" 
                           OnClick="@ToggleDarkMode" 
                           aria-label="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")"
                           title="@(_isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")" />
            
            <ProfileMenu />
        </MudAppBar>
        
        <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Mini" OpenMiniOnHover="true">
            <NavMenu />
        </MudDrawer>
        
        <MudMainContent Class="chart-main">
            <MudContainer MaxWidth="MaxWidth.False" Class="pa-3">
                <Breadcrumbs />
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
    
<SessionMonitor />
<ToastContainer />
<StickyNoteContainer />
@if (!PatientAskGuard.IsPatientMode(Navigation.Uri))
{
    <DashboardAsk />
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private int _unreadMessages = 0;

    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#0D47A1",
            Secondary = "#00695C",
            Tertiary = "#004D40",
            TertiaryContrastText = "#FFFFFF",
            TextPrimary = "#212121",
            TextSecondary = "#424242",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#424242",
            Background = "#F5F5F5",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#424242",
            Success = "#2E7D32",
            SuccessContrastText = "#FFFFFF",
            Warning = "#9A3412",
            WarningContrastText = "#FFFFFF",
            Error = "#B71C1C",
            ErrorContrastText = "#FFFFFF",
            Info = "#1565C0",
            InfoContrastText = "#FFFFFF"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#90CAF9",
            Secondary = "#80CBC4",
            AppbarBackground = "#1E1E1E",
            AppbarText = "#FFFFFF",
            Background = "#121212",
            Surface = "#1E1E1E",
            DrawerBackground = "#1E1E1E",
            DrawerText = "#FFFFFF",
            Success = "#2E7D32",
            SuccessContrastText = "#FFFFFF",
            Warning = "#9A3412",
            WarningContrastText = "#FFFFFF",
            Error = "#B71C1C",
            ErrorContrastText = "#FFFFFF",
            Info = "#1565C0",
            InfoContrastText = "#FFFFFF"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography() { FontFamily = ["Inter", "Roboto", "Helvetica", "Arial", "sans-serif"] }
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "8px"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        _ = Trail.PreviousPath;
        var state = await AuthenticationState.GetAuthenticationStateAsync();
        await AuthSync.BindCircuitAsync(state.User);
        AuthenticationState.AuthenticationStateChanged += OnAuthenticationChanged;
        AuthState.OnAuthStateChanged += OnStateChangedHandler;
        AppState.OnStateChanged += OnStateChangedHandler;
        ClinicalData.InboxChanged += OnInboxDataChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await RefreshUnreadMessageCountAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RememberInAppPathAsync(Navigation.Uri);
        }
    }

    private void OnInboxDataChanged() => _ = InboxUpdateAsync();

    private async Task InboxUpdateAsync()
    {
        await InvokeAsync(async () =>
        {
            await RefreshUnreadMessageCountAsync();
            StateHasChanged();
        });
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (PatientAskGuard.IsPatientMode(e.Location))
        {
            DashboardAskSession.IsOpen = false;
        }

        _ = InvokeAsync(async () =>
        {
            await RememberInAppPathAsync(e.Location);
            StateHasChanged();
        });
    }

    private async Task RememberInAppPathAsync(string uri)
    {
        var relative = NavigationTrail.ToRelative(uri);
        if (NavigationTrail.IsPatientChart(relative))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("zebrahoofRememberInAppPath", relative);
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSException)
        {
        }
    }

    private async void OnStateChangedHandler()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async void OnAuthenticationChanged(Task<AuthenticationState> task)
    {
        var state = await task;
        await AuthSync.BindCircuitAsync(state.User);
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshUnreadMessageCountAsync()
    {
        _unreadMessages = await ClinicalData.GetUnreadMessageCountAsync();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    
    private void ToggleDarkMode() => _isDarkMode = !_isDarkMode;

    private void SetLocation(string location)
    {
        AuthState.SetLocation(location);
    }

    public void Dispose()
    {
        AuthenticationState.AuthenticationStateChanged -= OnAuthenticationChanged;
        AuthState.OnAuthStateChanged -= OnStateChangedHandler;
        AppState.OnStateChanged -= OnStateChangedHandler;
        ClinicalData.InboxChanged -= OnInboxDataChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
