@inject ILogger<ErrorHandler> Logger
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@using System.Diagnostics
@using Zebrahoof_EMR.Components.Shared

<CascadingValue Value="this">
    <ErrorBoundary @ref="_boundary">
        <ChildContent>
            @ChildContent
        </ChildContent>
        <ErrorContent Context="ex">
            @if (ex is ChartNotHeldException closed)
            {
                <ChartClosedPanel Exception="closed" OnLeave="LeaveClosedChart" />
            }
            else
            {
                Logger.LogError(ex, "Unhandled error in component (PatientId: {PatientId})",
                    (ex.Data["PatientId"] as int?) ?? 0);
                NotificationService.ShowError($"An unexpected error occurred. Details have been logged. Correlation ID: {Activity.Current?.Id ?? "unknown"}");
                <MudAlert Severity="Severity.Error" Class="my-4">
                    An error occurred. Check the logs for details (Correlation ID above).
                    <MudButton OnClick="Recover" Color="Color.Primary" Variant="Variant.Filled" Class="ml-4">Retry</MudButton>
                </MudAlert>
            }
        </ErrorContent>
    </ErrorBoundary>
</CascadingValue>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private ErrorBoundary? _boundary;

    private void Recover() => _boundary?.Recover();

    private void LeaveClosedChart(ChartNotHeldException closed)
    {
        _boundary?.Recover();
        if (closed.OpenedPatientId is int id)
        {
            Navigation.NavigateTo($"/patients/{id}/summary");
            return;
        }

        Navigation.NavigateTo("/dashboard");
    }

    public static void AddPatientContext(Exception ex, int? patientId)
    {
        if (patientId.HasValue)
            ex.Data["PatientId"] = patientId.Value;
    }
}
