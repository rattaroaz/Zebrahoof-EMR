@implements IDisposable
@inject NavigationManager Navigation
@inject MockPatientService PatientService
@inject MockClinicalDataService ClinicalData

@if (_items.Count > 1)
{
    <MudBreadcrumbs Items="_items" Class="pa-0 mb-1 chart-breadcrumbs">
        <ItemTemplate Context="item">
            @if (string.IsNullOrEmpty(item.Href))
            {
                <MudText Typo="Typo.body2">@item.Text</MudText>
            }
            else
            {
                <MudLink Href="@item.Href" Typo="Typo.body2">@item.Text</MudLink>
            }
        </ItemTemplate>
        <SeparatorTemplate>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="mx-1" />
        </SeparatorTemplate>
    </MudBreadcrumbs>
}

@code {
    private List<BreadcrumbItem> _items = new();
    private string? _builtFor;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _ = ReloadAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;
        if (path == _builtFor && _items.Count > 0)
        {
            return;
        }

        var names = new Dictionary<int, string>();
        if (PatientRoute.TryParsePatientId(path, out var patientId))
        {
            var patient = await PatientService.GetPatientByIdAsync(patientId);
            if (patient != null)
            {
                names[patientId] = patient.FullName;
            }
        }

        (int PatientId, string Name)? encounterCrumb = null;
        if (PatientRoute.TryParseEncounterId(path, out var encounterId))
        {
            var encounter = await ClinicalData.GetEncounterByIdAsync(encounterId);
            if (encounter != null)
            {
                var patient = await PatientService.GetPatientByIdAsync(encounter.PatientId);
                encounterCrumb = (encounter.PatientId, patient?.FullName ?? encounter.PatientName);
            }
        }

        var crumbs = BreadcrumbText.Build(path, id => names.GetValueOrDefault(id), _ => encounterCrumb);

        _items = crumbs.Select(c => new BreadcrumbItem(c.Text, c.Href, disabled: c.Href == null)).ToList();
        _builtFor = path;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
