@using Zebrahoof_EMR.Services
@inject DashboardAskService AskService
@inject DashboardAskSession AskSession
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ILogger<DashboardAsk> Logger

@if (!AskSession.IsOpen)
{
    <div class="chart-ask-launcher">
        <MudTooltip Text="Ask a general question">
            <button type="button" class="chart-ask-launcher-btn" @onclick="Open" aria-label="Ask AI">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" />
                <span>Ask AI</span>
            </button>
        </MudTooltip>
    </div>
}
else
{
    <div class="chart-ask-panel" role="dialog" aria-label="Ask AI">
        <div class="chart-ask-header">
            <div class="chart-ask-brand">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                <span>Ask AI</span>
            </div>
            <div class="chart-ask-header-actions">
                @if (AskSession.Turns.Count > 0)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep"
                                   Size="Size.Small"
                                   Disabled="@_isProcessing"
                                   title="New conversation"
                                   OnClick="Clear" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               title="Close"
                               OnClick="Close" />
            </div>
        </div>

        <div id="dashboard-ask-thread" class="chart-ask-thread">
            <LocalAiNotReadyAlert Class="ma-3" />

            @if (AskSession.Turns.Count == 0)
            {
                <div class="chart-ask-empty">
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Class="chart-ask-empty-icon" />
                    <MudText Typo="Typo.h6">Ask a general question</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Answers are clinic-wide and do not assume a particular patient.
                    </MudText>
                </div>
            }
            else
            {
                @foreach (var turn in AskSession.Turns)
                {
                    <div class="chart-ask-row chart-ask-row-user">
                        <div class="chart-ask-bubble chart-ask-bubble-user">@turn.UserInput</div>
                    </div>
                    <div class="chart-ask-row chart-ask-row-ai">
                        <div class="chart-ask-bubble chart-ask-bubble-ai">
                            @if (turn.IsProcessing)
                            {
                                <span class="chart-ask-thinking">Thinking</span>
                            }
                            else
                            {
                                <div style="white-space: pre-wrap;">@turn.Answer</div>
                                @if (turn.WarnMix)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="chart-ask-mix-warning" Variant="Variant.Outlined">
                                        @PatientAskGuard.MixWarning
                                    </MudAlert>
                                }
                                @if (turn.Applied.Count > 0)
                                {
                                    <div class="chart-ask-applied">
                                        @foreach (var change in turn.Applied)
                                        {
                                            <span class="chart-ask-chip">@change</span>
                                        }
                                    </div>
                                }
                                @if (turn.Patients.Count > 0)
                                {
                                    <div class="chart-ask-applied">
                                        @foreach (var hit in turn.Patients)
                                        {
                                            <button type="button" class="chart-ask-chip chart-ask-chip-link"
                                                    @onclick="@(() => OpenChart(hit.Id))">
                                                Open @hit.Name
                                            </button>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <div class="chart-ask-composer">
            <textarea class="chart-ask-input"
                      rows="2"
                      placeholder="Ask a general question…"
                      @bind="_input"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      disabled="@_isProcessing"></textarea>
            <button type="button"
                    class="chart-ask-send"
                    disabled="@(string.IsNullOrWhiteSpace(_input) || _isProcessing)"
                    @onclick="SendAsync"
                    aria-label="Send">
                @if (_isProcessing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" />
                }
            </button>
        </div>
    </div>
}

@code {
    private string _input = string.Empty;
    private bool _isProcessing;
    private bool _scrollAfterRender;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollAfterRender)
        {
            return;
        }

        _scrollAfterRender = false;
        try
        {
            await JS.InvokeVoidAsync("eval",
                "var el=document.getElementById('dashboard-ask-thread'); if(el) el.scrollTop=el.scrollHeight;");
        }
        catch
        {
        }
    }

    private void Open() => AskSession.IsOpen = true;

    private void Close() => AskSession.IsOpen = false;

    private void OpenChart(int patientId) => Navigation.NavigateTo($"/patients/{patientId}/chart");

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !string.IsNullOrWhiteSpace(_input) && !_isProcessing)
        {
            await SendAsync();
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_input) || _isProcessing)
        {
            return;
        }

        var message = _input.Trim();
        _input = string.Empty;
        var history = AskSession.Turns
            .Where(t => !t.IsProcessing && !string.IsNullOrWhiteSpace(t.Answer))
            .Select(t => new ChartAskTurn(t.UserInput, t.Answer))
            .ToList();

        var turn = new ClinicAskInteraction
        {
            UserInput = message,
            IsProcessing = true,
            CreatedAt = DateTime.Now
        };
        AskSession.Turns.Add(turn);
        _isProcessing = true;
        _scrollAfterRender = true;

        try
        {
            var result = await AskService.AskAsync(message, history);
            turn.Answer = result.Answer;
            turn.Patients = result.Patients.ToList();
            turn.Applied = result.Applied.ToList();
            turn.WarnMix = result.WarnMix;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Dashboard ask failed");
            turn.Answer = $"Could not complete that request: {ex.Message}";
            Snackbar.Add(turn.Answer, Severity.Error);
        }
        finally
        {
            turn.IsProcessing = false;
            _isProcessing = false;
            _scrollAfterRender = true;
        }
    }

    private void Clear()
    {
        if (_isProcessing)
        {
            return;
        }

        AskSession.Clear();
    }
}
