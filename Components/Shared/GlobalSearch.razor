@inject NavigationManager Navigation
@inject MockPatientService PatientService

<div class="global-search">
    <MudTextField T="string"
                  Value="@_text"
                  ValueChanged="OnTextChanged"
                  Immediate="true"
                  Label="Search patients..."
                  Placeholder="Name, MRN, or DOB"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="global-search-field"
                  aria-label="Search patients" />
    @if (_open && _text.Trim().Length >= 2)
    {
        <MudPaper Class="global-search-menu" Elevation="8">
            @if (_results.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="pa-2 mud-text-secondary">No patients found</MudText>
            }
            else
            {
                @foreach (var patient in _results)
                {
                    <button type="button" class="global-search-item" @onclick="() => Choose(patient)">
                        <span class="global-search-item-name">@patient.FullName</span>
                        <span class="global-search-item-meta">MRN @patient.MRN · DOB @patient.DateOfBirth.ToString("MM/dd/yyyy")</span>
                    </button>
                }
            }
        </MudPaper>
    }
</div>

@code {
    private string _text = "";
    private bool _open;
    private int _version;
    private List<Patient> _results = new();

    private async Task OnTextChanged(string value)
    {
        _text = value ?? "";
        _open = true;
        var version = ++_version;
        var term = _text;
        if (term.Trim().Length < 2)
        {
            _results = new();
            return;
        }

        await Task.Delay(120);
        if (version != _version)
        {
            return;
        }

        var found = await PatientService.SearchPatientsAsync(term);
        if (version != _version)
        {
            return;
        }

        _results = found.Take(10).ToList();
    }

    private void Choose(Patient patient)
    {
        _text = "";
        _open = false;
        _results = new();
        _version++;
        Navigation.NavigateTo($"/patients/{patient.Id}/summary");
    }
}
