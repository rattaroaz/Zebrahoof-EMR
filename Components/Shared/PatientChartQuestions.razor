@using Zebrahoof_EMR.Models
@using Zebrahoof_EMR.Services
@inject PatientChartAskService AskService
@inject PatientChartAskSession AskSession
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ILogger<PatientChartQuestions> Logger
@inject AskAiCoordinator AskAi
@implements IDisposable

@if (AskSession.IsOpen(Patient.Id))
{
    <div class="chart-ask-panel" role="dialog" aria-label="Ask AI">
        <div class="chart-ask-header">
            <div class="chart-ask-brand">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                <span>Ask AI</span>
            </div>
            <div class="chart-ask-header-actions">
                @if (_turns.Count > 0)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep"
                                   Size="Size.Small"
                                   Disabled="@_isProcessing"
                                   title="New conversation"
                                   OnClick="Clear" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               title="Close"
                               OnClick="Close" />
            </div>
        </div>

        <div id="@ThreadId" class="chart-ask-thread">
            <LocalAiNotReadyAlert Class="ma-3" />

            @if (_turns.Count == 0)
            {
                <div class="chart-ask-empty">
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Class="chart-ask-empty-icon" />
                    <MudText Typo="Typo.h6">Ask about this patient</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Questions are about @Patient.FullName by default. The AI can answer or change this chart.
                    </MudText>
                </div>
            }
            else
            {
                @foreach (var turn in _turns)
                {
                    <div class="chart-ask-row chart-ask-row-user">
                        <div class="chart-ask-bubble chart-ask-bubble-user">@turn.UserInput</div>
                    </div>
                    <div class="chart-ask-row chart-ask-row-ai">
                        <div class="chart-ask-bubble chart-ask-bubble-ai">
                            @if (turn.IsProcessing)
                            {
                                <span class="chart-ask-thinking">Thinking</span>
                            }
                            else
                            {
                                <div style="white-space: pre-wrap;">@turn.Answer</div>
                                @if (turn.WarnMix)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="chart-ask-mix-warning" Variant="Variant.Outlined">
                                        @PatientAskGuard.MixWarning
                                    </MudAlert>
                                }
                                @if (turn.Applied.Count > 0)
                                {
                                    <div class="chart-ask-applied">
                                        @foreach (var change in turn.Applied)
                                        {
                                            <span class="chart-ask-chip">@change</span>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <div class="chart-ask-composer">
            <textarea class="chart-ask-input"
                      rows="2"
                      placeholder="Ask about this patient…"
                      @bind="_input"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      disabled="@_isProcessing"></textarea>
            <button type="button"
                    class="chart-ask-send"
                    disabled="@(string.IsNullOrWhiteSpace(_input) || _isProcessing)"
                    @onclick="SendAsync"
                    aria-label="Send">
                @if (_isProcessing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" />
                }
            </button>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Patient Patient { get; set; } = null!;

    private string _input = string.Empty;
    private bool _isProcessing;
    private bool _scrollAfterRender;
    private List<ChartAskInteraction> _turns = [];

    private string ThreadId => $"chart-ask-thread-{Patient.Id}";

    protected override void OnParametersSet()
    {
        _turns = AskSession.For(Patient.Id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollAfterRender)
        {
            return;
        }

        _scrollAfterRender = false;
        try
        {
            await JS.InvokeVoidAsync("eval",
                $"var el=document.getElementById('{ThreadId}'); if(el) el.scrollTop=el.scrollHeight;");
        }
        catch
        {
            // Panel may have closed before scroll.
        }
    }

    protected override void OnInitialized()
    {
        AskAi.OpenRequested += Open;
    }

    public void Dispose() => AskAi.OpenRequested -= Open;

    private void Open() => AskSession.SetOpen(Patient.Id, true);

    private void Close() => AskSession.SetOpen(Patient.Id, false);

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !string.IsNullOrWhiteSpace(_input) && !_isProcessing)
        {
            await SendAsync();
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_input) || _isProcessing)
        {
            return;
        }

        var message = _input.Trim();
        _input = string.Empty;
        var history = _turns
            .Where(t => !t.IsProcessing && !string.IsNullOrWhiteSpace(t.Answer))
            .Select(t => new ChartAskTurn(t.UserInput, t.Answer))
            .ToList();

        var turn = new ChartAskInteraction
        {
            UserInput = message,
            IsProcessing = true,
            CreatedAt = DateTime.Now
        };
        _turns.Add(turn);
        _isProcessing = true;
        _scrollAfterRender = true;

        try
        {
            var result = await AskService.AskAsync(Patient, message, history);
            turn.Answer = result.Answer;
            turn.Applied = result.Applied.ToList();
            turn.WarnMix = result.WarnMix;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Chart ask failed for patient {PatientId}", Patient.Id);
            turn.Answer = $"Could not complete that request: {ex.Message}";
            Snackbar.Add(turn.Answer, Severity.Error);
        }
        finally
        {
            turn.IsProcessing = false;
            _isProcessing = false;
            _scrollAfterRender = true;
        }
    }

    private void Clear()
    {
        if (_isProcessing)
        {
            return;
        }

        AskSession.Clear(Patient.Id);
        _turns = AskSession.For(Patient.Id);
    }
}
