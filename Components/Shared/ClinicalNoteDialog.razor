@using Microsoft.AspNetCore.Http
@implements IDisposable
@inject MockClinicalDataService ClinicalDataService
@inject AuthStateService AuthState
@inject MockPatientService PatientService
@inject ChartEditTracker Edits
@inject NoteDraftService Drafts
@inject DraftAutosaveGate Autosave
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<ClinicalNoteDialog> Logger

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@(IsViewOnly ? Icons.Material.Filled.Visibility : Icons.Material.Filled.NoteAdd)" Color="Color.Primary" />
            <MudText Typo="Typo.h6">
                @(IsViewOnly ? "View Clinical Note" : (IsEdit ? "Edit Clinical Note" : "New Clinical Note"))
            </MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <PatientSafetyBanner PatientId="@(PatientId > 0 ? PatientId : note.PatientId)" />
        @if (!string.IsNullOrEmpty(_saveError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@_saveError</MudAlert>
        }
        @if (_draftRestored)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2" data-testid="draft-restored">
                Draft restored
            </MudAlert>
        }
        <MudStack Spacing="4" Class="pa-2">
            @if (IsViewOnly)
            {
                <!-- Note metadata for view mode -->
                <MudPaper Elevation="1" Class="pa-3">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Note ID</MudText>
                            <MudText Typo="Typo.body2">#@note.Id</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Author</MudText>
                            <MudText Typo="Typo.body2">@note.AuthorName</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Created</MudText>
                            <MudText Typo="Typo.body2">@ClinicTime.Format(note.CreatedAt, "MMM dd, yyyy h:mm tt")</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Status</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@GetNoteStatusColor(note.Status)">
                                @note.Status
                            </MudChip>
                        </MudItem>
                        @if (note.SignedAt.HasValue)
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Signed</MudText>
                                <MudText Typo="Typo.body2">✓ @note.SignedAt?.ToString("MMM dd, yyyy HH:mm")</MudText>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            }
            
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="note.ChiefComplaint" @bind-Value:after="QueueDraftSave"
                                  Label="Chief Complaint" 
                                  Variant="Variant.Outlined" 
                                  Required="true"
                                  Immediate="true"
                                  Disabled="@IsViewOnly"
                                  Class="@(@IsViewOnly ? "dark-disabled-text" : "")" />
                </MudItem>
            </MudGrid>

            <MudTextField @bind-Value="note.HistoryOfPresentIllness" @bind-Value:after="QueueDraftSave"
                          Label="History of Present Illness" 
                          Variant="Variant.Outlined" 
                          Lines="4" 
                          Required="true"
                          Disabled="@IsViewOnly"
                          Immediate="true"
                          Class="@(@IsViewOnly ? "dark-disabled-text" : "")" />

            <MudTextField @bind-Value="note.ReviewOfSystems" @bind-Value:after="QueueDraftSave"
                          Label="Review of Systems" 
                          Variant="Variant.Outlined" 
                          Lines="3" 
                          Disabled="@IsViewOnly"
                          Immediate="true"
                          Class="@(@IsViewOnly ? "dark-disabled-text" : "")" />

            <MudTextField @bind-Value="note.PhysicalExam" @bind-Value:after="QueueDraftSave"
                          Label="Physical Examination" 
                          Variant="Variant.Outlined" 
                          Lines="4" 
                          Disabled="@IsViewOnly"
                          Immediate="true"
                          Class="@(@IsViewOnly ? "dark-disabled-text" : "")" />

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="note.Assessment" @bind-Value:after="QueueDraftSave"
                                  Label="Assessment" 
                                  Variant="Variant.Outlined" 
                                  Lines="3" 
                                  Disabled="@IsViewOnly"
                                  Immediate="true"
                                  Class="@(@IsViewOnly ? "dark-disabled-text" : "")" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="note.Plan" @bind-Value:after="QueueDraftSave"
                                  Label="Plan" 
                                  Variant="Variant.Outlined" 
                                  Lines="3" 
                                  Disabled="@IsViewOnly"
                                  Immediate="true"
                                  Class="@(@IsViewOnly ? "dark-disabled-text" : "")" />
                </MudItem>
            </MudGrid>

            @if (!IsViewOnly)
            {
                <MudDivider Class="my-2" />
                
                <MudSwitch @bind-Value="signNote" T="bool" Label="Sign Note (Finalize)" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (IsViewOnly)
        {
            <MudButton OnClick="Cancel">Close</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveNote">
                @(IsEdit ? "Update Note" : "Create Note")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public int PatientId { get; set; }

    [Parameter]
    public ClinicalNote? Note { get; set; }

    [Parameter]
    public bool IsEdit { get; set; }

    [Parameter]
    public bool IsViewOnly { get; set; }

    private ClinicalNote note = new();
    private bool signNote = false;
    private bool _saved;
    private bool _draftRestored;
    private IDisposable? _editScope;
    private string? _saveError;
    private CancellationTokenSource? _draftDebounce;
    private CancellationTokenSource? _draftFlush;
    private long _draftEpoch;

    protected override void OnInitialized()
    {
        Logger.LogDebug("ClinicalNoteDialog init: viewOnly {ViewOnly} edit {Edit} noteId {NoteId}", IsViewOnly, IsEdit, Note?.Id);

        if ((IsEdit || IsViewOnly) && Note != null)
        {
            Logger.LogDebug("Loading note {NoteId} for display/edit", Note.Id);
            note = new ClinicalNote
            {
                Id = Note.Id,
                PatientId = Note.PatientId,
                EncounterId = Note.EncounterId,
                AuthorName = Note.AuthorName,
                ChiefComplaint = Note.ChiefComplaint,
                HistoryOfPresentIllness = Note.HistoryOfPresentIllness,
                ReviewOfSystems = Note.ReviewOfSystems,
                PhysicalExam = Note.PhysicalExam,
                Assessment = Note.Assessment,
                Plan = Note.Plan,
                Status = Note.Status,
                SignedAt = Note.SignedAt,
                CreatedAt = Note.CreatedAt
            };
        }
        else
        {
            Logger.LogDebug("New note for patient {PatientId}", PatientId);
            EnsureAutosave();
            var draft = Drafts.Get(DraftUser, Autosave.BrowserId, PatientId);
            _draftRestored = draft is { IsEmpty: false };
            note = new ClinicalNote
            {
                PatientId = PatientId,
                AuthorName = AuthState.CurrentUser?.FullName ?? "Unknown",
                CreatedAt = DateTime.UtcNow,
                Status = NoteStatus.InProgress,
                ChiefComplaint = draft?.ChiefComplaint,
                HistoryOfPresentIllness = draft?.HistoryOfPresentIllness,
                ReviewOfSystems = draft?.ReviewOfSystems,
                PhysicalExam = draft?.PhysicalExam,
                Assessment = draft?.Assessment,
                Plan = draft?.Plan
            };
        }

        if (!IsEdit)
        {
            signNote = false;
        }
        else if (note.Status == NoteStatus.Signed)
        {
            signNote = true;
        }

        Logger.LogDebug("ClinicalNoteDialog ready. NoteId {NoteId} status {Status}", note.Id, note.Status);
        if (!IsViewOnly)
        {
            var id = PatientId > 0 ? PatientId : note.PatientId;
            _editScope = Edits.Push(id);
        }

        Edits.DiscardRequested += OnDiscardRequested;
        EnsureAutosave();

        _draftEpoch = Autosave.Epoch;
        if (!IsViewOnly && !IsEdit)
        {
            _draftFlush = new CancellationTokenSource();
            _ = FlushDraftWhileOpen(_draftFlush.Token);
        }
    }

    private void QueueDraftSave()
    {
        _draftDebounce?.Cancel();
        _draftDebounce?.Dispose();
        _draftDebounce = new CancellationTokenSource();
        var token = _draftDebounce.Token;
        _ = DebouncedSave(token);
    }

    private async Task DebouncedSave(CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(400), token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        try
        {
            await InvokeAsync(PersistDraft);
        }
        catch (Exception ex) when (ex is ObjectDisposedException or InvalidOperationException)
        {
        }
    }

    private async Task FlushDraftWhileOpen(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (!Autosave.Enabled)
                {
                    break;
                }

                await InvokeAsync(PersistDraft);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException or InvalidOperationException)
        {
        }
    }

    private void OnDiscardRequested() => MudDialog.Cancel();

    private string DraftUser => AuthState.CurrentUser?.Username ?? string.Empty;

    private void EnsureAutosave()
    {
        if (Autosave.EpochCaptured)
        {
            return;
        }

        var browserId = DraftBrowser.Read(HttpContextAccessor.HttpContext);
        Autosave.Capture(browserId, Drafts.CurrentEpoch(browserId));
    }

    private void PersistDraft()
    {
        if (!Autosave.Enabled || !Autosave.EpochCaptured || IsViewOnly || IsEdit || _saved)
        {
            return;
        }

        var saved = Drafts.TrySave(DraftUser, Autosave.BrowserId, PatientId > 0 ? PatientId : note.PatientId, new NoteDraft
        {
            ChiefComplaint = note.ChiefComplaint,
            HistoryOfPresentIllness = note.HistoryOfPresentIllness,
            ReviewOfSystems = note.ReviewOfSystems,
            PhysicalExam = note.PhysicalExam,
            Assessment = note.Assessment,
            Plan = note.Plan
        }, _draftEpoch);
        if (!saved)
        {
            Autosave.Stop();
            Logger.LogInformation(
                "Draft save rejected for {User} patient {PatientId}; the session is older than sign-out",
                DraftUser,
                PatientId > 0 ? PatientId : note.PatientId);
        }
    }

    public void Dispose()
    {
        _draftDebounce?.Cancel();
        _draftFlush?.Cancel();
        PersistDraft();
        _draftDebounce?.Dispose();
        _draftFlush?.Dispose();
        Edits.DiscardRequested -= OnDiscardRequested;
        _editScope?.Dispose();
        _editScope = null;
    }

    private async Task SaveNote()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(note.ChiefComplaint))
            {
                // Show validation error
                return;
            }

            if (string.IsNullOrWhiteSpace(note.HistoryOfPresentIllness))
            {
                // Show validation error
                return;
            }

            // Set status based on user choice
            if (signNote && CanSignNote())
            {
                note.SignedAt = DateTime.UtcNow;
                note.Status = NoteStatus.Signed;
            }
            else
            {
                note.Status = NoteStatus.InProgress;
                note.SignedAt = null;
            }

            if (IsEdit)
            {
                await ClinicalDataService.UpdateNoteAsync(note);
            }
            else
            {
                await ClinicalDataService.CreateNoteAsync(note);
                _saved = true;
                Drafts.Clear(DraftUser, Autosave.BrowserId, note.PatientId);
            }

            MudDialog.Close(DialogResult.Ok(note));
        }
        catch (ChartNotHeldException)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save clinical note for patient {PatientId} (edit: {IsEdit}, noteId: {NoteId})",
                PatientId, IsEdit, note?.Id);
            _saveError = "The note could not be saved.";
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private bool CanSignNote()
    {
        return AuthState.CurrentUser?.Role == UserRole.Physician ||
               AuthState.CurrentUser?.Role == UserRole.Nurse ||
               AuthState.CurrentUser?.Role == UserRole.MedicalAssistant;
    }

    private Color GetNoteStatusColor(NoteStatus status)
    {
        return status switch
        {
            NoteStatus.InProgress => Color.Warning,
            NoteStatus.Signed => Color.Success,
            NoteStatus.Addended => Color.Info,
            NoteStatus.Cosigned => Color.Primary,
            _ => Color.Default
        };
    }
}
