@inject MockClinicalDataService ClinicalDataService
@inject PatientDialogTracker Dialogs
@inject ISnackbar Snackbar
@implements IDisposable

<MudCard Elevation="2">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Allergies</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAdd">
                Add Allergy
            </MudButton>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent Class="pa-0">
        @if (_allergies.Count == 0)
        {
            <MudAlert Severity="Severity.Success" Class="ma-4">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                    <MudText>No Known Allergies (NKA)</MudText>
                </MudStack>
            </MudAlert>
        }
        else
        {
            <MudTable Items="@_allergies" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>Allergen</MudTh>
                    <MudTh>Reaction</MudTh>
                    <MudTh>Severity</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Onset Date</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Allergen">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="@GetSeverityColor(context.Severity)" Size="Size.Small" />
                            @context.Allergen
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Reaction">@(context.Reaction ?? "—")</MudTd>
                    <MudTd DataLabel="Severity">
                        <MudChip T="string" Size="Size.Small" Color="@GetSeverityColor(context.Severity)">@context.Severity</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">@context.Status</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Onset">@(context.OnsetDate?.ToString("MM/dd/yyyy") ?? "Unknown")</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@($"Edit {context.Allergen}")" OnClick="@(() => OpenEdit(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@($"Remove {context.Allergen}")" OnClick="@(() => Remove(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudCardContent>
</MudCard>

<MudDialog @bind-Visible="_showDialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editingId == null ? "Add Allergy" : "Edit Allergy")</MudText>
    </TitleContent>
    <DialogContent>
        <PatientSafetyBanner PatientId="PatientId" />
        <MudTextField @bind-Value="_allergen" Label="Allergen" Required="true" Class="mt-2" />
        <MudTextField @bind-Value="_reaction" Label="Reaction" Class="mt-2" />
        <MudSelect @bind-Value="_severity" Label="Severity" Class="mt-2">
            @foreach (var severity in Enum.GetValues<AllergySeverity>())
            {
                <MudSelectItem Value="@severity">@severity</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired]
    public int PatientId { get; set; }

    private List<Allergy> _allergies = new();
    private bool _showDialog;
    private int? _editingId;
    private string _allergen = string.Empty;
    private string? _reaction;
    private AllergySeverity _severity = AllergySeverity.Moderate;
    private IDisposable? _dialogLease;

    protected override void OnInitialized() => _dialogLease = Dialogs.TrackInline(CloseDialog);

    protected override async Task OnParametersSetAsync()
    {
        ClinicalDataService.PatientDataChanged -= OnPatientDataChanged;
        ClinicalDataService.PatientDataChanged += OnPatientDataChanged;
        _allergies = await ClinicalDataService.GetAllergiesByPatientAsync(PatientId);
    }

    private async void OnPatientDataChanged(int patientId)
    {
        if (patientId != PatientId) return;
        _allergies = await ClinicalDataService.GetAllergiesByPatientAsync(PatientId);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ClinicalDataService.PatientDataChanged -= OnPatientDataChanged;
        _dialogLease?.Dispose();
    }

    private void CloseDialog() => _showDialog = false;

    private void OpenAdd()
    {
        _editingId = null;
        _allergen = string.Empty;
        _reaction = null;
        _severity = AllergySeverity.Moderate;
        _showDialog = true;
    }

    private void OpenEdit(Allergy allergy)
    {
        _editingId = allergy.Id;
        _allergen = allergy.Allergen;
        _reaction = allergy.Reaction;
        _severity = allergy.Severity;
        _showDialog = true;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_allergen))
        {
            return;
        }

        if (_editingId is int id)
        {
            await ClinicalDataService.UpdateAllergyAsync(PatientId, id, allergy =>
            {
                allergy.Allergen = _allergen.Trim();
                allergy.Reaction = _reaction;
                allergy.Severity = _severity;
            });
        }
        else
        {
            await ClinicalDataService.AddAllergyAsync(new Allergy
            {
                PatientId = PatientId,
                Allergen = _allergen.Trim(),
                Reaction = _reaction,
                Severity = _severity,
                Status = AllergyStatus.Active,
                OnsetDate = DateTime.Today
            });
        }

        CloseDialog();
        Snackbar.Add("Allergy saved", Severity.Success);
    }

    private async Task Remove(Allergy allergy)
    {
        await ClinicalDataService.RemoveAllergyAsync(PatientId, allergy.Allergen);
        Snackbar.Add($"{allergy.Allergen} removed", Severity.Info);
    }

    private Color GetSeverityColor(AllergySeverity severity) => severity switch
    {
        AllergySeverity.LifeThreatening => Color.Error,
        AllergySeverity.Severe => Color.Error,
        AllergySeverity.Moderate => Color.Warning,
        AllergySeverity.Mild => Color.Info,
        _ => Color.Default
    };

    private Color GetStatusColor(AllergyStatus status) => status switch
    {
        AllergyStatus.Active => Color.Warning,
        AllergyStatus.Inactive => Color.Default,
        AllergyStatus.Resolved => Color.Success,
        _ => Color.Default
    };
}
