@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject PatientDialogTracker Dialogs

<div class="patient-banner-sticky" data-testid="patient-banner">
    <MudPaper Elevation="1" Class="patient-banner px-3 py-2 mb-2">
        <div class="patient-banner-row">
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/patients"))">
                Back
            </MudButton>
            <MudAvatar Size="Size.Small" Color="Color.Primary">@Initials</MudAvatar>
            <div class="patient-banner-id">
                <div class="patient-banner-name">@Patient.LastName, @Patient.FirstName</div>
                <div class="patient-banner-meta">
                    MRN @Patient.MRN · DOB @Patient.DateOfBirth.ToString("MM/dd/yyyy") (@Patient.Age y @SexInitial)
                    · @Patient.PrimaryProvider
                    ·
                    @if (Patient.Allergies.Any())
                    {
                        <span class="patient-allergy-names">@string.Join(", ", Patient.Allergies)</span>
                    }
                    else
                    {
                        <span class="patient-allergy-none">NKA</span>
                    }
                    @foreach (var alert in Patient.Alerts)
                    {
                        <span class="patient-alert-name"> · @alert</span>
                    }
                </div>
            </div>
            <div class="patient-banner-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Science" OnClick="ShowOrderDialog">Order tests</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.NoteAdd" OnClick="ShowNewNote" data-testid="banner-new-note">New Note</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.EventAvailable" OnClick="ShowAppointments" data-testid="banner-appointments">Appointments</MudButton>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AriaLabel="More chart actions">
                    <MudMenuItem Icon="@Icons.Material.Filled.Science" OnClick="ShowOrderDialog">Order tests</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.NoteAdd" OnClick="ShowNewNote">New Note</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Print">Print Summary</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Send">Send Message</MudMenuItem>
                </MudMenu>
            </div>
        </div>
    </MudPaper>
</div>

@code {
    [Parameter, EditorRequired]
    public Patient Patient { get; set; } = null!;

    private string Initials => $"{Patient.FirstName.FirstOrDefault()}{Patient.LastName.FirstOrDefault()}";

    private string SexInitial => Patient.Sex.StartsWith("F", StringComparison.OrdinalIgnoreCase) ? "F"
        : Patient.Sex.StartsWith("M", StringComparison.OrdinalIgnoreCase) ? "M"
        : Patient.Sex;

    private async Task ShowNewNote()
    {
        var parameters = new DialogParameters
        {
            ["PatientId"] = Patient.Id,
            ["IsEdit"] = false
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };
        Dialogs.Track(await DialogService.ShowAsync<ClinicalNoteDialog>("New Clinical Note", parameters, options));
    }

    private async Task ShowOrderDialog()
    {
        var parameters = new DialogParameters<OrderEntryDialog>
        {
            { x => x.PatientId, Patient.Id },
            { x => x.PatientName, Patient.FullName },
            { x => x.InitialFilter, OrderCatalogFilter.All }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };
        Dialogs.Track(await DialogService.ShowAsync<OrderEntryDialog>("Order tests", parameters, options));
    }

    private async Task ShowAppointments()
    {
        var parameters = new DialogParameters { ["PatientId"] = Patient.Id };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<PatientAppointmentsDialog>("Appointments", parameters, options);
        Dialogs.Track(dialog);
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data?.ToString() == "schedule")
        {
            Navigation.NavigateTo("/schedule");
        }
    }
}
