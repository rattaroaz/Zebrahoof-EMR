@inject MockClinicalDataService ClinicalDataService
@inject OpenChartView ChartView
@inject AuthStateService AuthState
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Clinical Notes - Zebrahoof EMR</PageTitle>

<MudStack Spacing="4">
    <!-- Header with View Toggle -->
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h5">Clinical Notes</MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="notes-toolbar">
            <MudTextField @bind-Value="_query" Placeholder="Search notes" Label="Search notes" Margin="Margin.Dense"
                          Immediate="true" Variant="Variant.Outlined" Class="notes-search" />
            <MudButton Variant="Variant.Outlined" OnClick="ToggleShowAll">@(_showAll ? "Virtual list" : "Show all notes")</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="PrintNotes">Print</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AccountTree" OnClick="@NavigateToTreeView">
                Tree View
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@OpenNewNoteDialog">
                New Note
            </MudButton>
        </MudStack>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_query))
    {
        <p class="print-filter-notice">Filtered: showing notes that match "@_query".</p>
    }
    <p class="notes-print-meta">Printed @ClinicTime.Format(DateTime.UtcNow, "MMM dd, yyyy h:mm tt")@(_query is { Length: > 0 } ? $" · Filtered to \"{_query}\"" : "")</p>

    <!-- Notes List -->
    <MudCard Elevation="2">
        <MudCardContent>
            @if (_notes == null || _notes.Count == 0)
            {
                <MudStack AlignItems="AlignItems.Center" Class="pa-8">
                    <MudIcon Icon="@Icons.Material.Filled.NoteAdd" Size="Size.Large" Class="mud-text-secondary" />
                    <MudText Typo="Typo.h6" Class="mud-text-secondary">No clinical notes found</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary text-center">
                        Click "New Note" to create the first clinical note for this patient.
                    </MudText>
                    <MudButton Variant="Variant.Outlined" OnClick="@OpenNewNoteDialog" Class="mt-2">
                        Create First Note
                    </MudButton>
                </MudStack>
            }
            else if (_visible.Count == 0)
            {
                <MudText Class="pa-4">No notes match that search.</MudText>
            }
            else if (_showAll)
            {
                <div class="notes-all-list" data-testid="notes-list">
                    @foreach (var note in _visible)
                    {
                        <PatientNoteCard Note="note" CanSign="CanSignNote()" OnEdit="EditNote" OnDelete="DeleteNote" OnSign="SignNote" OnView="ViewNote" />
                    }
                </div>
            }
            else
            {
                <div class="notes-virtual-list" data-testid="notes-list">
                    <Virtualize Items="_visible" Context="note" OverscanCount="2" ItemSize="160">
                        <PatientNoteCard Note="note" CanSign="CanSignNote()" OnEdit="EditNote" OnDelete="DeleteNote" OnSign="SignNote" OnView="ViewNote" />
                    </Virtualize>
                </div>
            }
        </MudCardContent>
    </MudCard>
</MudStack>

@code {
    [Parameter]
    public int PatientId { get; set; }

    private List<ClinicalNote>? _notes;
    private string _query = string.Empty;
    private bool _showAll;

    private List<ClinicalNote> _visible =>
        (_notes ?? new List<ClinicalNote>())
            .Where(note => string.IsNullOrWhiteSpace(_query)
                || (note.ChiefComplaint?.Contains(_query, StringComparison.OrdinalIgnoreCase) ?? false)
                || (note.HistoryOfPresentIllness?.Contains(_query, StringComparison.OrdinalIgnoreCase) ?? false)
                || (note.Assessment?.Contains(_query, StringComparison.OrdinalIgnoreCase) ?? false)
                || (note.Plan?.Contains(_query, StringComparison.OrdinalIgnoreCase) ?? false)
                || (note.AuthorName?.Contains(_query, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

    private void ToggleShowAll() => _showAll = !_showAll;

    private async Task PrintNotes()
    {
        _showAll = true;
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("print");
    }

    protected override async Task OnInitializedAsync()
    {
        ChartView.Changed += OnChartViewChanged;
        await LoadNotes();
    }

    private void OnChartViewChanged() => _ = InvokeAsync(async () =>
    {
        await LoadNotes();
        StateHasChanged();
    });

    public void Dispose() => ChartView.Changed -= OnChartViewChanged;

    private async Task LoadNotes()
    {
        if (ChartView.Snapshot is { } snap && snap.PatientId == PatientId)
        {
            _notes = snap.Notes.OrderByDescending(note => note.CreatedAt).ToList();
            return;
        }

        var notes = await ClinicalDataService.GetPatientNotesAsync(PatientId);
        _notes = notes.OrderByDescending(note => note.CreatedAt).ToList();
    }

    private void NavigateToTreeView()
    {
        Navigation.NavigateTo($"/patients/{PatientId}/notes/tree");
    }

    private async Task OpenNewNoteDialog()
    {
        var parameters = new DialogParameters
        {
            ["PatientId"] = PatientId,
            ["IsEdit"] = false
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<ClinicalNoteDialog>("New Clinical Note", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadNotes();
        }
    }

    private async Task ViewNote(ClinicalNote note)
    {
        var parameters = new DialogParameters
        {
            ["Note"] = note,
            ["IsViewOnly"] = true
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        await DialogService.ShowAsync<ClinicalNoteDialog>("Clinical Note", parameters, options);
    }

    private async Task EditNote(ClinicalNote note)
    {
        var parameters = new DialogParameters
        {
            ["PatientId"] = PatientId,
            ["Note"] = note,
            ["IsEdit"] = true
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<ClinicalNoteDialog>("Edit Clinical Note", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadNotes();
        }
    }

    private async Task DeleteNote(ClinicalNote note)
    {
        var result = await DialogService.ShowMessageBox(
            "Delete Note",
            $"Are you sure you want to delete this clinical note? This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions { MaxWidth = MaxWidth.Small }
        );

        if (result == true)
        {
            await ClinicalDataService.DeleteNoteAsync(note.Id);
            await LoadNotes();
        }
    }

    private async Task SignNote(ClinicalNote note)
    {
        note.SignedAt = DateTime.UtcNow;
        note.Status = NoteStatus.Signed;

        await ClinicalDataService.UpdateNoteAsync(note);
        await LoadNotes();
    }

    private bool CanSignNote()
    {
        return AuthState.CurrentUser?.Role == UserRole.Physician ||
               AuthState.CurrentUser?.Role == UserRole.Nurse ||
               AuthState.CurrentUser?.Role == UserRole.MedicalAssistant;
    }

}
