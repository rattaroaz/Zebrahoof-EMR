@using Microsoft.EntityFrameworkCore
@using Zebrahoof_EMR.Data
@using Zebrahoof_EMR.Models
@using Zebrahoof_EMR.Services
@inject MockClinicalDataService ClinicalDataService
@inject MockPatientService PatientService
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<PatientSummary> Logger
@implements IDisposable

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2" Class="mb-3">
    <MudText Typo="Typo.subtitle1">Chart windows</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        Drag a title bar to change the order. Windows stay in a grid with space between them.
    </MudText>
    <MudSpacer />
    <MudMenu Label="Add window"
             Variant="Variant.Filled"
             Color="Color.Primary"
             StartIcon="@Icons.Material.Filled.Add"
             Disabled="@(_hiddenWindows.Count == 0)"
             AnchorOrigin="Origin.BottomRight"
             TransformOrigin="Origin.TopRight">
        @if (_hiddenWindows.Count == 0)
        {
            <MudText Typo="Typo.caption" Class="pa-3">Every tab is already on this summary.</MudText>
        }
        else
        {
            @foreach (var window in _hiddenWindows)
            {
                var key = window.Key;
                <MudMenuItem Icon="@window.Icon" OnClick="@(() => AddWindowAsync(key))">@window.Label</MudMenuItem>
            }
        }
    </MudMenu>
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetLayoutAsync">
        Reset layout
    </MudButton>
</MudStack>

@if (_visibleKeys.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        No windows on this summary. Use <strong>Add window</strong> to place a chart tab here.
    </MudAlert>
}
else
{
    <div class="summary-window-grid">
        @foreach (var key in _visibleKeys)
        {
            var def = ChartSummaryWindows.Find(key);
            if (def == null)
            {
                continue;
            }

            var windowKey = def.Key;
            <div @key="windowKey"
                 id="@WindowElementId(windowKey)"
                 class="summary-window-item"
                 data-key="@windowKey">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <div class="summary-window-handle" title="Drag to rearrange">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Class="mud-text-secondary" />
                            </div>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <div class="summary-window-handle">
                                <MudText Typo="Typo.h6">@def.Label</MudText>
                            </div>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (def.HasTab)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                               Size="Size.Small"
                                               title="@($"Open {def.Label} tab")"
                                               OnClick="@(() => OpenTab(windowKey))"
                                               @onmousedown:stopPropagation="true" />
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small"
                                           title="Remove window"
                                           OnClick="@(() => RemoveWindowAsync(windowKey))"
                                           @onmousedown:stopPropagation="true" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    @RenderWindowBody(windowKey)
                </MudCard>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public int PatientId { get; set; }

    private List<string> _visibleKeys = ChartSummaryWindows.DefaultVisible.ToList();
    private IReadOnlyList<ChartSummaryWindowDef> _hiddenWindows = Array.Empty<ChartSummaryWindowDef>();
    private DotNetObjectReference<PatientSummary>? _jsRef;
    private bool _isDragging;

    private static string WindowElementId(string key) => $"summary-win-{key}";

    private List<Problem> _problems = new();
    private List<Medication> _medications = new();
    private List<Allergy> _allergies = new();
    private List<LabResult> _labs = new();
    private VitalSigns? _latestVitals;
    private List<Encounter> _encounters = new();
    private List<RiskScoreEntry> _riskScores = new();
    private List<SimulatedOrderRecord> _orders = new();
    private List<ImagingStudy> _imaging = new();
    private List<Immunization> _immunizations = new();
    private List<Document> _documents = new();
    private List<ClinicalNote> _notes = new();
    private List<CareTeamMember> _careTeam = new();
    private Patient? _patient;

    protected override async Task OnParametersSetAsync()
    {
        _problems = await ClinicalDataService.GetActiveProblemsByPatientAsync(PatientId);
        _medications = await ClinicalDataService.GetMedicationListAsync(PatientId);
        _allergies = await ClinicalDataService.GetActiveAllergiesByPatientAsync(PatientId);
        _labs = await ClinicalDataService.GetRecentLabResultsByPatientAsync(PatientId, 5);
        _latestVitals = await ClinicalDataService.GetLatestVitalsByPatientAsync(PatientId);
        _encounters = await ClinicalDataService.GetEncountersByPatientAsync(PatientId);
        _riskScores = await ClinicalDataService.GetRiskScoresByPatientAsync(PatientId);
        _orders = await ClinicalDataService.GetSimulatedOrdersByPatientAsync(PatientId);
        _imaging = await ClinicalDataService.GetImagingByPatientAsync(PatientId);
        _immunizations = await ClinicalDataService.GetImmunizationsByPatientAsync(PatientId);
        _notes = await ClinicalDataService.GetPatientNotesAsync(PatientId);
        _careTeam = await ClinicalDataService.GetCareTeamByPatientAsync(PatientId);
        _patient = await PatientService.GetPatientByIdAsync(PatientId);
        try
        {
            _documents = await Db.Documents
                .Where(d => d.PatientId == PatientId)
                .OrderByDescending(d => d.Date)
                .Take(5)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not load documents for summary windows (PatientId: {PatientId})", PatientId);
            _documents = new();
        }
    }

    protected override bool ShouldRender() => !_isDragging;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _jsRef ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("summaryWindowDrag.attach", _jsRef);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not attach summary window drag");
        }

        if (!firstRender)
        {
            return;
        }

        await LoadLayoutAsync();
        RefreshHidden();
        StateHasChanged();
    }

    private async Task LoadLayoutAsync()
    {
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ChartSummaryWindows.StorageKey);
            _visibleKeys = ChartSummaryWindows.ParseLayout(saved);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load summary window layout");
            _visibleKeys = ChartSummaryWindows.DefaultVisible.ToList();
        }
    }

    private async Task SaveLayoutAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ChartSummaryWindows.StorageKey, ChartSummaryWindows.SerializeLayout(_visibleKeys));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to save summary window layout");
        }
    }

    private void RefreshHidden() =>
        _hiddenWindows = ChartSummaryWindows.Hidden(_visibleKeys);

    private async Task AddWindowAsync(string key)
    {
        _visibleKeys = ChartSummaryWindows.Add(_visibleKeys, key);
        RefreshHidden();
        await SaveLayoutAsync();
    }

    private async Task RemoveWindowAsync(string key)
    {
        _visibleKeys = ChartSummaryWindows.Remove(_visibleKeys, key);
        RefreshHidden();
        await SaveLayoutAsync();
    }

    private async Task ResetLayoutAsync()
    {
        _visibleKeys = ChartSummaryWindows.DefaultVisible.ToList();
        RefreshHidden();
        await SaveLayoutAsync();
    }

    [JSInvokable]
    public void BeginWindowDrag() => _isDragging = true;

    [JSInvokable]
    public async Task ApplyWindowOrder(List<string> keys)
    {
        _isDragging = false;
        var next = ChartSummaryWindows.ResolveVisible(keys).ToList();
        if (!next.SequenceEqual(_visibleKeys, StringComparer.Ordinal))
        {
            _visibleKeys = next;
            await SaveLayoutAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("summaryWindowDrag.detach");
        _jsRef?.Dispose();
    }

    private void OpenTab(string key) =>
        Navigation.NavigateTo($"/patients/{PatientId}/{key}");

    private RenderFragment RenderWindowBody(string key) => key switch
    {
        "problems" => ProblemsBody,
        "medications" => MedicationsBody,
        "allergies" => AllergiesBody,
        "labs" => LabsBody,
        "vitals" => VitalsBody,
        "encounter" => EncountersBody,
        "risk" => RiskBody,
        "orders" => OrdersBody,
        "imaging" => ImagingBody,
        "history" => HistoryBody,
        "immunizations" => ImmunizationsBody,
        "documents" => DocumentsBody,
        "notes" => NotesBody,
        "careteam" => CareTeamBody,
        "demographics" => DemographicsBody,
        _ => builder =>
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "pa-3");
            builder.AddContent(2, "Nothing to show.");
            builder.CloseElement();
        }
    };

    private RenderFragment ProblemsBody => __builder =>
    {
        <MudCardContent Class="pa-0">
            @if (_problems.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="ma-3">No active problems</MudAlert>
            }
            else
            {
                <MudList T="Problem" Dense="true">
                    @foreach (var problem in _problems.Take(5))
                    {
                        <MudListItem>
                            <div class="d-flex justify-space-between align-center" style="width: 100%;">
                                <div>
                                    <MudText Typo="Typo.body2">@problem.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @problem.IcdCode • Since @problem.OnsetDate.ToString("MM/yyyy")
                                    </MudText>
                                </div>
                                @if (!string.IsNullOrEmpty(problem.Severity))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="@GetSeverityColor(problem.Severity)">@problem.Severity</MudChip>
                                }
                            </div>
                        </MudListItem>
                    }
                </MudList>
                @if (_problems.Count > 5)
                {
                    <MudButton Variant="Variant.Text" FullWidth="true" OnClick="@(() => OpenTab("problems"))">
                        View All (@_problems.Count)
                    </MudButton>
                }
            }
        </MudCardContent>
    };

    private RenderFragment MedicationsBody => __builder =>
    {
        <MudCardContent Class="pa-0">
            @if (_medications.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="ma-3">No active medications</MudAlert>
            }
            else
            {
                <MudList T="Medication" Dense="true">
                    @foreach (var med in _medications.Take(5))
                    {
                        <MudListItem>
                            <div>
                                <MudText Typo="Typo.body2">
                                    @med.Name @med.Dose
                                    @if (med.IsHighRisk)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" />
                                    }
                                </MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@med.Frequency • @med.Route</MudText>
                            </div>
                        </MudListItem>
                    }
                </MudList>
                @if (_medications.Count > 5)
                {
                    <MudButton Variant="Variant.Text" FullWidth="true" OnClick="@(() => OpenTab("medications"))">
                        View All (@_medications.Count)
                    </MudButton>
                }
            }
        </MudCardContent>
    };

    private RenderFragment AllergiesBody => __builder =>
    {
        <MudCardContent Class="pa-0">
            @if (_allergies.Count == 0)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="ma-3">
                    <MudIcon Icon="@Icons.Material.Filled.Check" Class="mr-2" /> No Known Allergies (NKA)
                </MudAlert>
            }
            else
            {
                <MudList T="Allergy" Dense="true">
                    @foreach (var allergy in _allergies)
                    {
                        <MudListItem>
                            <div class="d-flex justify-space-between align-center" style="width: 100%;">
                                <div>
                                    <MudText Typo="Typo.body2">@allergy.Allergen</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@allergy.Reaction</MudText>
                                </div>
                                <MudChip T="string" Size="Size.Small" Color="@GetAllergySeverityColor(allergy.Severity)">@allergy.Severity</MudChip>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudCardContent>
    };

    private RenderFragment LabsBody => __builder =>
    {
        <MudCardContent Class="pa-0">
            @if (_labs.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="ma-3">No recent lab results</MudAlert>
            }
            else
            {
                <MudList T="LabResult" Dense="true">
                    @foreach (var lab in _labs.Take(5))
                    {
                        <MudListItem>
                            <div class="d-flex justify-space-between align-center" style="width: 100%;">
                                <div>
                                    <MudText Typo="Typo.body2">@lab.TestName</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@lab.CollectedAt.ToString("MM/dd/yyyy")</MudText>
                                </div>
                                <MudText Typo="Typo.body2" Color="@(lab.IsAbnormal ? Color.Error : Color.Default)" Style="@(lab.IsCritical ? "font-weight: bold;" : "")">
                                    @lab.Value @lab.Units
                                </MudText>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudCardContent>
    };

    private RenderFragment VitalsBody => __builder =>
    {
        <MudCardContent>
            @if (_latestVitals == null)
            {
                <MudAlert Severity="Severity.Info" Dense="true">No vitals recorded</MudAlert>
            }
            else
            {
                <MudGrid Spacing="2">
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Blood Pressure</MudText>
                        <MudText Typo="Typo.body1">@_latestVitals.SystolicBP/@_latestVitals.DiastolicBP mmHg</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Heart Rate</MudText>
                        <MudText Typo="Typo.body1">@_latestVitals.HeartRate bpm</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Temperature</MudText>
                        <MudText Typo="Typo.body1">@_latestVitals.Temperature °F</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">SpO2</MudText>
                        <MudText Typo="Typo.body1">@_latestVitals.OxygenSaturation%</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Weight</MudText>
                        <MudText Typo="Typo.body1">@_latestVitals.Weight lbs</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">BMI</MudText>
                        <MudText Typo="Typo.body1">@_latestVitals.BMI</MudText>
                    </MudItem>
                </MudGrid>
            }
        </MudCardContent>
    };

    private RenderFragment EncountersBody => __builder =>
    {
        <MudCardContent Class="pa-0">
            @if (_encounters.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="ma-3">No encounters recorded</MudAlert>
            }
            else
            {
                <MudTimeline TimelinePosition="TimelinePosition.Start" Class="pa-2">
                    @foreach (var encounter in _encounters.Take(4))
                    {
                        <MudTimelineItem Size="Size.Small" Color="@(encounter.Status == EncounterStatus.Signed ? Color.Success : Color.Warning)">
                            <MudText Typo="Typo.body2">@encounter.VisitType</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @encounter.DateTime.ToString("MM/dd/yyyy") • @encounter.Provider
                            </MudText>
                        </MudTimelineItem>
                    }
                </MudTimeline>
            }
        </MudCardContent>
    };

    private RenderFragment RiskBody => __builder =>
    {
        <MudCardContent>
            <RiskScorePanel Scores="_riskScores" />
        </MudCardContent>
    };

    private RenderFragment OrdersBody => __builder =>
    {
        <MudCardContent Class="pa-0">
            @if (_orders.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="ma-3">No orders yet</MudAlert>
            }
            else
            {
                <MudList T="SimulatedOrderRecord" Dense="true">
                    @foreach (var order in _orders.Take(5))
                    {
                        <MudListItem>
                            <MudText Typo="Typo.body2">@order.DisplayName</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@order.Type • @order.Status</MudText>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudCardContent>
    };

    private RenderFragment ImagingBody => __builder =>
    {
        <MudCardContent Class="pa-0">
            @if (_imaging.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="ma-3">No imaging studies</MudAlert>
            }
            else
            {
                <MudList T="ImagingStudy" Dense="true">
                    @foreach (var study in _imaging.Take(5))
                    {
                        <MudListItem>
                            <MudText Typo="Typo.body2">@study.Description</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@study.Modality • @study.StudyDate.ToString("MM/dd/yyyy")</MudText>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudCardContent>
    };

    private RenderFragment HistoryBody => __builder =>
    {
        <MudCardContent Class="pa-0">
            <MudList T="string" Dense="true">
                <MudListItem>Hypertension — 2018</MudListItem>
                <MudListItem>Type 2 Diabetes — 2015</MudListItem>
                <MudListItem>Hyperlipidemia — 2019</MudListItem>
            </MudList>
        </MudCardContent>
    };

    private RenderFragment ImmunizationsBody => __builder =>
    {
        <MudCardContent Class="pa-0">
            @if (_immunizations.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="ma-3">No immunizations recorded</MudAlert>
            }
            else
            {
                <MudList T="Immunization" Dense="true">
                    @foreach (var shot in _immunizations.Take(5))
                    {
                        <MudListItem>
                            <MudText Typo="Typo.body2">@shot.VaccineName</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@shot.AdministeredDate.ToString("MM/dd/yyyy")</MudText>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudCardContent>
    };

    private RenderFragment DocumentsBody => __builder =>
    {
        <MudCardContent Class="pa-0">
            @if (_documents.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="ma-3">No documents uploaded</MudAlert>
            }
            else
            {
                <MudList T="Document" Dense="true">
                    @foreach (var doc in _documents)
                    {
                        <MudListItem>
                            <MudText Typo="Typo.body2">@doc.Name</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@doc.Category • @doc.Date.ToString("MM/dd/yyyy")</MudText>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudCardContent>
    };

    private RenderFragment NotesBody => __builder =>
    {
        <MudCardContent Class="pa-0">
            @if (_notes.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="ma-3">No notes</MudAlert>
            }
            else
            {
                <MudList T="ClinicalNote" Dense="true">
                    @foreach (var note in _notes.Take(5))
                    {
                        <MudListItem>
                            <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(note.ChiefComplaint) ? "Note" : note.ChiefComplaint)</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@note.AuthorName • @note.CreatedAt.ToString("MM/dd/yyyy")</MudText>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudCardContent>
    };

    private RenderFragment CareTeamBody => __builder =>
    {
        <MudCardContent Class="pa-0">
            @if (_careTeam.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="ma-3">No care team members</MudAlert>
            }
            else
            {
                <MudList T="CareTeamMember" Dense="true">
                    @foreach (var member in _careTeam.Take(5))
                    {
                        <MudListItem>
                            <MudText Typo="Typo.body2">@member.Name</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@member.Role</MudText>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudCardContent>
    };

    private RenderFragment DemographicsBody => __builder =>
    {
        <MudCardContent>
            @if (_patient == null)
            {
                <MudAlert Severity="Severity.Info" Dense="true">Demographics unavailable</MudAlert>
            }
            else
            {
                <MudText Typo="Typo.body2">@_patient.FullName</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">MRN @_patient.MRN • @_patient.DateOfBirth.ToString("MM/dd/yyyy") • Age @_patient.Age</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@_patient.Sex • @_patient.PrimaryProvider</MudText>
            }
        </MudCardContent>
    };

    private Color GetSeverityColor(string severity) => severity?.ToLower() switch
    {
        "severe" => Color.Error,
        "moderate" => Color.Warning,
        "mild" => Color.Info,
        _ => Color.Default
    };

    private Color GetAllergySeverityColor(AllergySeverity severity) => severity switch
    {
        AllergySeverity.LifeThreatening => Color.Error,
        AllergySeverity.Severe => Color.Error,
        AllergySeverity.Moderate => Color.Warning,
        AllergySeverity.Mild => Color.Info,
        _ => Color.Default
    };
}
