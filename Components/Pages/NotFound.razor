@page "/not-found"
@layout AuthLayout
@attribute [AllowAnonymous]

<PageTitle>Not found - Zebrahoof EMR</PageTitle>

<MudCard Elevation="4" Class="pa-4" Style="width: 100%; max-width: 420px;">
    <MudCardContent>
        <MudText Typo="Typo.h5" Class="mb-2">Page not found</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            That address is not a page in Zebrahoof EMR.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" FullWidth="true">
            Back to home
        </MudButton>
    </MudCardContent>
</MudCard>
