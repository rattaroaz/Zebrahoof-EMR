@page "/admin/local-ai"

<PageTitle>Local AI - Zebrahoof EMR</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />

<MudText Typo="Typo.h5" Class="mb-2">Local AI Engine</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Encounter chat, document analysis, and record updates run on this machine.
    For each family (Qwen, DeepSeek, Gemma, GPT-OSS) the app offers the five
    strongest models that will run on this PC. Downloaded models stay on this
    drive and are reused — you do not need to download them again. The model
    you pick stays in use until you pick a different one. The library
    refreshes at most once a week. You can stop a download at any time.
    Clinical data is not sent to a cloud AI.
</MudText>

<LocalAiEnginePanel />

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new("Admin", "/admin", icon: Icons.Material.Filled.AdminPanelSettings),
        new("Local AI", "/admin/local-ai", disabled: true)
    };
}
